{
  "name": "anthropic_client_to_openai_provider",
  "category": "transcode",
  "client_protocol": "anthropic",
  "target_protocol": "openai",
  "description": "Anthropic request transcribed to OpenAI; cache_control on system and tools is dropped as unsupported.",
  "request": {
    "model": "claude-test",
    "system": [
      {
        "type": "text",
        "text": "SYSTEM_POLICY_SENTINEL_DO_NOT_COMPRESS You are a helpful assistant.",
        "cache_control": {
          "type": "ephemeral"
        }
      }
    ],
    "messages": [
      {
        "role": "user",
        "content": "LONG_USER_INSTRUCTION Help me with this task."
      },
      {
        "role": "assistant",
        "content": [
          {
            "type": "text",
            "text": "I will help you."
          }
        ]
      },
      {
        "role": "user",
        "content": "LATEST_USER_SENTINEL Thanks."
      }
    ],
    "tools": [
      {
        "name": "search",
        "description": "Search files.",
        "cache_control": {
          "type": "ephemeral"
        },
        "input_schema": {
          "type": "object",
          "properties": {
            "query": {
              "type": "string"
            }
          },
          "required": [
            "query"
          ]
        }
      },
      {
        "name": "TOOL_SCHEMA_SENTINEL_DO_NOT_COMPRESS",
        "description": "Returns a string.",
        "input_schema": {
          "type": "object",
          "properties": {
            "query": {
              "type": "string"
            }
          },
          "required": [
            "query"
          ]
        }
      }
    ],
    "max_tokens": 1024
  },
  "expectations": {
    "transcoder_drops_unsupported_target": true,
    "cache_stability_status_counts": {
      "dropped_unsupported_target": 2
    }
  }
}
