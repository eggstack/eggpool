{
  "name": "openai_client_to_anthropic_provider",
  "category": "transcode",
  "client_protocol": "openai",
  "target_protocol": "anthropic",
  "description": "OpenAI request transcribed to Anthropic; exercises cache_stability observation with native cache_control on a tool.",
  "request": {
    "model": "gpt-test",
    "messages": [
      {
        "role": "system",
        "content": "SYSTEM_POLICY_SENTINEL_DO_NOT_COMPRESS You are a helpful assistant."
      },
      {
        "role": "user",
        "content": "LONG_USER_INSTRUCTION Search and analyze."
      },
      {
        "role": "assistant",
        "content": null,
        "tool_calls": [
          {
            "id": "synthetic_call_001",
            "type": "function",
            "function": {
              "name": "search",
              "arguments": "{\"query\": \"test\"}"
            }
          }
        ]
      },
      {
        "role": "tool",
        "tool_call_id": "synthetic_call_001",
        "content": "VOLATILE_LOG_LINE connection timeout\nresult_1\nresult_2\nresult_3"
      },
      {
        "role": "user",
        "content": "LATEST_USER_SENTINEL Done."
      }
    ],
    "tools": [
      {
        "type": "function",
        "cache_control": {
          "type": "ephemeral"
        },
        "function": {
          "name": "search",
          "description": "Search files.",
          "parameters": {
            "type": "object",
            "properties": {
              "query": {
                "type": "string"
              }
            },
            "required": [
              "query"
            ]
          }
        }
      },
      {
        "type": "function",
        "function": {
          "name": "TOOL_SCHEMA_SENTINEL_DO_NOT_COMPRESS",
          "description": "Returns a string.",
          "parameters": {
            "type": "object",
            "properties": {
              "query": {
                "type": "string"
              }
            },
            "required": [
              "query"
            ]
          }
        }
      }
    ]
  },
  "expectations": {
    "cache_stability_status_counts": {
      "preserved": 1
    },
    "transcoder_drops_unsupported_target": false
  }
}
