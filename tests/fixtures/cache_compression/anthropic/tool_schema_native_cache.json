{
  "name": "tool_schema_native_cache",
  "category": "anthropic",
  "client_protocol": "anthropic",
  "target_protocol": "anthropic",
  "description": "Anthropic request with native cache_control on a tool schema; dry_run synthetic because no policy override.",
  "request": {
    "model": "claude-test",
    "system": [
      {
        "type": "text",
        "text": "SYSTEM_POLICY_SENTINEL_DO_NOT_COMPRESS You are a helpful assistant."
      }
    ],
    "messages": [
      {
        "role": "user",
        "content": "LATEST_USER_SENTINEL Use the tools to help me."
      }
    ],
    "tools": [
      {
        "name": "TOOL_SCHEMA_SENTINEL_DO_NOT_COMPRESS",
        "description": "Returns a string.",
        "cache_control": {
          "type": "ephemeral"
        },
        "input_schema": {
          "type": "object",
          "properties": {
            "query": {
              "type": "string"
            }
          },
          "required": [
            "query"
          ]
        }
      },
      {
        "name": "other_tool",
        "description": "Another tool.",
        "input_schema": {
          "type": "object",
          "properties": {
            "param": {
              "type": "string"
            }
          },
          "required": [
            "param"
          ]
        }
      }
    ],
    "max_tokens": 1024
  },
  "expectations": {
    "transcoder_preserves_native_cache_control": true,
    "synthetic_cache_status": "dry_run"
  }
}
