{
  "schema_version": 1,
  "plan": "O001",
  "observation_kind": "python-oracle",
  "cli": {
    "command_count": 63,
    "global_config_position": "before-command",
    "unknown_command_exit": 2,
    "missing_argument_exit": 2,
    "validation_failure_exit": 1,
    "json_surfaces": ["rehash", "runtime-status", "stats explain-dashboard", "stats transcoding"]
  },
  "paths": {
    "config_precedence": ["cli", "EGGPOOL_CONFIG", "xdg_existing", "cwd"],
    "runtime_precedence": ["EGGPOOL_RUNTIME_DIR", "private_xdg_runtime", "private_state_runtime", "uid_tmp_fallback"],
    "pid_precedence": ["EGGPOOL_PID_FILE", "xdg_runtime_pid", "state_pid", "uid_tmp_pid"],
    "log_precedence": ["EGGPOOL_LOG_FILE", "state_log", "uid_tmp_log"],
    "pid_content": "decimal-pid",
    "socket_name": "eggpool.sock",
    "socket_mode": "0600",
    "root_path_policy": "replace-isolated-root-with-token"
  },
  "control": {
    "protocol_version": 1,
    "command_set": ["reload_config"],
    "framing": "one-json-object-per-line-and-one-response-per-connection",
    "max_request_bytes": 65536,
    "max_request_id_length": 256,
    "timeout_seconds": 30,
    "digest": "exactly-64-lower-hex-or-absent",
    "response_fields": ["protocol_version", "request_id", "ok", "stage", "generation", "changed_sections", "warnings", "restart_required", "retirement_pending", "message"],
    "negative_cases": ["empty", "invalid-json", "non-object", "wrong-version", "missing-request-id", "unknown-command", "invalid-digest", "oversized", "multi-frame", "timeout"],
    "negative_effect": "handler-not-invoked"
  },
  "backup": {
    "format_version": 1,
    "filename_pattern": "eggpool-backup-YYYYMMDD-HHMMSS[-N].zip",
    "compression": "stored",
    "required_members": ["META", "config.toml", "usage.sqlite3"],
    "optional_members": [".env", "usage.sqlite3-wal", "usage.sqlite3-shm"],
    "runtime_snapshot": "consistent-sqlite-backup",
    "meta_db_path": "live-database-path",
    "restore_modes": {"config.toml": "0600", ".env": "0600"},
    "member_policy": "allowlist-and-fixed-target-no-escape",
    "publication": "atomic",
    "retention": "newest-retain-count"
  },
  "integrations": {
    "targets": ["opencode", "claude-code", "aider", "codex", "qwen-code", "kilo", "continue", "cline", "roo-code", "goose", "openhands"],
    "shared_options": ["--print-secret", "--no-clipboard", "--force", "--output", "--write", "--model", "--base-url", "--host"],
    "secret_default": "not-on-stdout",
    "clipboard": "best-effort-and-disableable",
    "overwrite": "force-required-and-different-content-backed-up",
    "live_provider_calls": false
  },
  "deployment": {
    "fake_commands_only": ["systemctl", "crontab", "logrotate"],
    "personal_paths": ["resolved-config", "resolved-data", "resolved-env", "resolved-state"],
    "production_paths": ["/etc/eggpool", "/var/lib/eggpool", "/var/log/eggpool", "/var/backups/eggpool"],
    "production_user": "eggpool",
    "systemd_foreground": true,
    "cron_watchdog_markers": ["BEGIN EggPool watchdog", "END EggPool watchdog"],
    "backup_cron_separate": true,
    "host_mutation": false
  },
  "update": {
    "exact_version_normalization": "optional-leading-v",
    "check_is_non_mutating": true,
    "config_database_overwrite": false,
    "source_exact_target": "reject",
    "failure_recovery": "old-install-remains-usable",
    "release_backend": "python-pypi-command-history; rust-artifact-backend-allowed"
  },
  "deferred_r008": {
    "count": 3,
    "names": ["metrics_flush", "update_checker", "automatic_backup"],
    "ownership": "process",
    "supervisor": "single-m8-process-task-supervisor",
    "overlap_policy": "supervisor-singleton",
    "reload": {
      "metrics_flush": "schedule-and-enabled-state-reconciled",
      "update_checker": "startup-owned-and-not-duplicated-on-generation-reload",
      "automatic_backup": "schedule-and-enabled-state-reconciled"
    },
    "fourth_capability": false,
    "already_registered_not_deferred": ["catalog_refresh", "retention_cleanup", "checkpoint"]
  },
  "backend_decisions": [
    "Rust may stage and verify a native artifact instead of invoking pip, pipx, or uv.",
    "Rust deploy output may use typed renderers instead of Python string helpers.",
    "Both preserve user-visible fields, safety checks, mutation boundaries, and failure classes."
  ],
  "secret_policy": {
    "persisted_secret_values": false,
    "real_home_paths": false,
    "real_network_addresses": false,
    "unbounded_subprocess_output": false,
    "synthetic_secret_sentinel": false
  }
}
